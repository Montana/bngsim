# Sphinx build output
docs/_build/

# scikit-build-core build tree (build-dir = "build/{wheel_tag}")
/build/

# Python bytecode caches
__pycache__/

# pytest's cache, with the suite's artifact caches inside it. pytest ignores its
# directory through a .gitignore it writes only when it creates the directory,
# and the pre-push hook can create it first (ci/pre_push_pytest.py).
.pytest_cache/

# macOS
.DS_Store

# Local development scratch area (untracked)
dev/

# local_ci.py / local_ci_smoke.py output: machine-specific, never committed
scripts/_reports/
scripts/local_ci_report-*.md
