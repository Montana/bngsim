# bngsim GH #1062 fixture: the rate law fB(x)*g() multiplies a local function
# by a global g() that reads MAB. BNG2.pl writes it as a function _rateLaw1(x)
# that calls g(), and NFsim leaves g's value stale the same way (z = -11).
begin model
begin parameters
  k 0.001
  kr 0.1
end parameters
begin molecule types
  A(b,c)
  B(a)
end molecule types
begin seed species
  A(b,c) 100
  B(a) 100
end seed species
begin observables
  Molecules AB A(b!1).B(a!1)
  Molecules AC A(c)
  Molecules MAB A(b!1).B(a!1)
end observables
begin functions
  fB(x) = k*(1+AC(x))
  g() = 1+0.01*MAB
end functions
begin reaction rules
  %x:A(b) + B(a) -> A(b!1).B(a!1) fB(x)*g()
  A(b!1).B(a!1) -> A(b) + B(a) kr
end reaction rules
end model
writeXML()
