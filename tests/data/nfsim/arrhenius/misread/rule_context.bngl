# An Arrhenius rule with a state in its reactant pattern: only A(s~1) unbinds.
#   A(s~1).B: k = exp(-(Ea0 + phi*dG)), dG = -G_AB = 2 -> exp(-0.9) = 0.4066
#   A(s~0).B: never unbinds
begin model
begin parameters
  Ea0 0.2
  phi 0.35
  G_AB -2
end parameters
begin molecule types
  A(b,s~0~1)
  B(a)
end molecule types
begin seed species
  A(b!1,s~1).B(a!1) 1000
  A(b!1,s~0).B(a!1) 1000
end seed species
begin energy patterns
  A(b!1).B(a!1) G_AB
end energy patterns
begin observables
  Molecules AB1 A(b!1,s~1).B(a!1)
  Molecules AB0 A(b!1,s~0).B(a!1)
end observables
begin reaction rules
  A(b!1,s~1).B(a!1) -> A(b,s~1) + B(a) Arrhenius(phi,Ea0)
end reaction rules
end model
generate_network({overwrite=>1})
writeXML()
