# A one-way unbinding rule named like the reverse half of a reversible rule,
# with no forward rule. BNG2: exp(-(Ea0 + phi*(-G_AB))) = exp(-0.9). RuleMonkey
# reads a rule named _reverse_... as a reverse half and gives it 1-phi.
begin model
begin parameters
  Ea0 0.2
  phi 0.35
  G_AB -2
end parameters
begin molecule types
  A(x)
  B(y)
end molecule types
begin seed species
  A(x!1).B(y!1) 1000
end seed species
begin energy patterns
  A(x!1).B(y!1) G_AB
end energy patterns
begin observables
  Molecules AB A(x!+)
end observables
begin reaction rules
  _reverse_u: A(x!1).B(y!1) -> A(x) + B(y) Arrhenius(phi,Ea0)
end reaction rules
end model
generate_network({overwrite=>1})
writeXML()
