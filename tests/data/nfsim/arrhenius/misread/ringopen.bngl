# Ring-opening Arrhenius rule: the product stays one complex. BNG2 fires it
# only where A and B stay connected (the ring A-B-C), at
# exp(-(0.2 - 0.35*G_AB)) = exp(-0.9); the open chain A(x!1,c).B(y!1,d) never.
begin model
begin parameters
  Ea0 0.2
  phi 0.35
  G_AB -2
end parameters
begin molecule types
  A(x,c)
  B(y,d)
  C(a,b)
end molecule types
begin seed species
  A(x!1,c!2).B(y!1,d!3).C(a!2,b!3) 1000
  A(x!1,c).B(y!1,d) 1000
end seed species
begin energy patterns
  A(x!1).B(y!1) G_AB
end energy patterns
begin observables
  Species Ring A(x!1,c!+).B(y!1)
  Species Open A(x!1,c).B(y!1)
end observables
begin reaction rules
  A(x!1).B(y!1) -> A(x).B(y) Arrhenius(phi,Ea0)
end reaction rules
end model
generate_network({overwrite=>1})
writeXML()
