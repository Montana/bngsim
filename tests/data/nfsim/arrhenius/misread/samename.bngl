# One-way Arrhenius unbinding of a singly bound bivalent ligand L(r!1,r).R(l!1).
# The cooperativity pattern L(r!1,r!+).R(l!1) needs the OTHER r bound, so it
# does not apply: BNG2 rate exp(-(Ea0+phi*(-G_LR))) = exp(-0.9) = 0.4066.
# If applied anyway: exp(-(0.2+0.35*3)) = 0.2865.
begin model
begin parameters
  Ea0 0.2
  phi 0.35
  G_LR -2
  G_full -1
end parameters
begin molecule types
  L(r,r)
  R(l)
end molecule types
begin seed species
  L(r!1,r).R(l!1) 1000
end seed species
begin energy patterns
  L(r!1).R(l!1) G_LR
  L(r!1,r!+).R(l!1) G_full
end energy patterns
begin observables
  Species AB1 L(r!+)
  Molecules AB0 R(l)
end observables
begin reaction rules
  L(r!1).R(l!1) -> L(r) + R(l) Arrhenius(phi,Ea0)
end reaction rules
end model
generate_network({overwrite=>1})
writeXML()
