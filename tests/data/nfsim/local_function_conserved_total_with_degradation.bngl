# bngsim GH #1062 fixture: the conserved-total model plus C() -> 0. That
# whole-species delete can never take an A, since C never shares a complex
# with A, so Atot = A() is still constant: allowed.
begin model
begin parameters
  k 0.001
  kr 0.1
  kd 0.05
end parameters
begin molecule types
  A(b,c)
  B(a)
  C()
end molecule types
begin seed species
  A(b,c) 100
  B(a) 100
  C() 100
end seed species
begin observables
  Molecules AB A(b!1).B(a!1)
  Molecules AC A(c)
  Molecules Atot A()
  Molecules Ctot C()
end observables
begin functions
  fA(x) = k*(1+AC(x))*(Atot/50)
end functions
begin reaction rules
  %x:A(b) + B(a) -> A(b!1).B(a!1) fA(x)
  A(b!1).B(a!1) -> A(b) + B(a) kr
  C() -> 0 kd
end reaction rules
end model
writeXML()
