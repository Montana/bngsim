<?xml version="1.0" encoding="UTF-8"?>
<!-- bngsim GH #854 fixture, written in BioNetGen 2.9.3's writeXML() form. -->
<!-- A linear birth-death process: A() -> 0 kdeg, 0 -> A() kp, A(0) = 5000. kp = 0 -->
<!-- at load, so a post-init set_param('kp', ...) must switch synthesis on. -->
<!-- Same model with A() in a compartment c of size 2, so the synthesis rule's
     propensity carries NFsim's zero-order volume conversion (kp * 2). -->
<sbml xmlns="http://www.sbml.org/sbml/level3" level="3" version="1">
  <model id="zero_order_switchable_rate_compartment">
    <ListOfParameters>
      <Parameter id="kdeg" type="Constant" value="0.7" expr="0.7"/>
      <Parameter id="kp" type="Constant" value="0" expr="0"/>
    </ListOfParameters>
    <ListOfMoleculeTypes>
      <MoleculeType id="A"/>
    </ListOfMoleculeTypes>
    <ListOfCompartments>
      <Compartment id="c" spatialDimensions="3" size="2"/>
    </ListOfCompartments>
    <ListOfSpecies>
      <Species id="S1" concentration="5000" name="A()" compartment="c">
        <ListOfMolecules>
          <Molecule id="S1_M1" name="A" compartment="c"/>
        </ListOfMolecules>
      </Species>
    </ListOfSpecies>
    <ListOfReactionRules>
      <ReactionRule id="RR1" name="_R1" symmetry_factor="1">
        <ListOfReactantPatterns>
          <ReactantPattern id="RR1_RP1">
            <ListOfMolecules>
              <Molecule id="RR1_RP1_M1" name="A" compartment="c"/>
            </ListOfMolecules>
          </ReactantPattern>
        </ListOfReactantPatterns>
        <ListOfProductPatterns>
        </ListOfProductPatterns>
        <RateLaw id="RR1_RateLaw" type="Ele" totalrate="0">
          <ListOfRateConstants>
            <RateConstant value="kdeg"/>
          </ListOfRateConstants>
        </RateLaw>
        <Map>
        </Map>
        <ListOfOperations>
          <Delete id="RR1_RP1" DeleteMolecules="0"/>
        </ListOfOperations>
      </ReactionRule>
      <ReactionRule id="RR2" name="_R2" symmetry_factor="1">
        <ListOfReactantPatterns>
        </ListOfReactantPatterns>
        <ListOfProductPatterns>
          <ProductPattern id="RR2_PP1">
            <ListOfMolecules>
              <Molecule id="RR2_PP1_M1" name="A" compartment="c"/>
            </ListOfMolecules>
          </ProductPattern>
        </ListOfProductPatterns>
        <RateLaw id="RR2_RateLaw" type="Ele" totalrate="0">
          <ListOfRateConstants>
            <RateConstant value="kp"/>
          </ListOfRateConstants>
        </RateLaw>
        <Map>
        </Map>
        <ListOfOperations>
          <Add id="RR2_PP1_M1"/>
        </ListOfOperations>
      </ReactionRule>
    </ListOfReactionRules>
    <ListOfObservables>
      <Observable id="O1" name="Atot" type="Molecules">
        <ListOfPatterns>
          <Pattern id="O1_P1">
            <ListOfMolecules>
              <Molecule id="O1_P1_M1" name="A"/>
            </ListOfMolecules>
          </Pattern>
        </ListOfPatterns>
      </Observable>
    </ListOfObservables>
    <ListOfFunctions>
    </ListOfFunctions>
  </model>
</sbml>
