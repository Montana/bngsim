# bngsim GH #1067 fixture: the same model with every compartment on a molecule
# (A()@EC) or a seed species, both of which NFsim reads: allowed, and it agrees
# with the network.
begin model
begin parameters
  kd 0.5
end parameters
begin compartments
  EC 3 1
  PM 2 1 EC
  CP 3 1 PM
end compartments
begin molecule types
  A(b)
end molecule types
begin seed species
  @EC:A(b) 200
  @CP:A(b) 100
end seed species
begin observables
  Molecules Atot A()
  Molecules AEC A()@EC
end observables
begin reaction rules
  A()@EC -> 0 kd
end reaction rules
end model
writeXML()
