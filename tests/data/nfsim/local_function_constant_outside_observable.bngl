# bngsim GH #1062 fixture: fA(x) reads NSrc outside its argument, but Src has
# no components and no rule names it, so NSrc can never change: allowed, even
# though B(a) -> 0 deletes molecules.
begin model
begin parameters
  k 0.001
  kd 0.01
end parameters
begin molecule types
  A(b,c)
  B(a)
  Src()
end molecule types
begin seed species
  A(b,c) 100
  B(a) 100
  Src() 5
end seed species
begin observables
  Molecules AC A(c)
  Molecules NSrc Src()
end observables
begin functions
  fA(x) = k*(1+AC(x))*NSrc
end functions
begin reaction rules
  %x:A(b) + B(a) -> A(b!1).B(a!1) fA(x)
  B(a) -> 0 kd
end reaction rules
end model
writeXML()
