# bngsim GH #1062 fixture: fA(x) reads the total Atot = A() outside its
# argument. No rule adds or deletes an A, so Atot is conserved and the read
# is not stale: NFsim runs it and agrees with the network.
begin model
begin parameters
  k 0.001
  kr 0.1
end parameters
begin molecule types
  A(b,c)
  B(a)
end molecule types
begin seed species
  A(b,c) 100
  B(a) 100
end seed species
begin observables
  Molecules AB A(b!1).B(a!1)
  Molecules AC A(c)
  Molecules Atot A()
end observables
begin functions
  fA(x) = k*(1+AC(x))*(Atot/50)
end functions
begin reaction rules
  %x:A(b) + B(a) -> A(b!1).B(a!1) fA(x)
  A(b!1).B(a!1) -> A(b) + B(a) kr
end reaction rules
end model
writeXML()
