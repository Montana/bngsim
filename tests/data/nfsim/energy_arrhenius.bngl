# bngsim GH #854 fixture: Arrhenius (energy-based) binding rules. NFsim's energy
# rule expansion is wrong (RuleWorld/nfsim#102), so bngsim refuses it on NFsim.
begin model
begin parameters
  Ea0 0
  phi 0.5
  Gf_AB 3.5
  Gf_BC 3.5
  Gf_coop -2
end parameters
begin molecule types
  A(b)
  B(a,c)
  C(b)
end molecule types
begin seed species
  A(b) 100
  B(a,c) 100
  C(b) 100
end seed species
begin observables
  Molecules AB A(b!1).B(a!1)
  Molecules BC B(c!1).C(b!1)
end observables
begin energy patterns
  A(b!1).B(a!1) Gf_AB
  B(c!1).C(b!1) Gf_BC
  A(b!1).B(a!1,c!2).C(b!2) Gf_coop
end energy patterns
begin reaction rules
  A(b) + B(a) <-> A(b!1).B(a!1) Arrhenius(phi,Ea0)
  B(c) + C(b) <-> B(c!1).C(b!1) Arrhenius(phi,Ea0)
end reaction rules
end model
writeXML()
